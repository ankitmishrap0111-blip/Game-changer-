# This server reads process.env directly. Set these in your shell, systemd unit or container.
PORT=8787
HOST=127.0.0.1
# sandbox = test ledger, simulated providers.  live = refuses every money step until providers.js is implemented.
MODE=sandbox
# Optional second listener bound to 127.0.0.1 only. Point your Tor onion service at it
# so /api/tor/status can truthfully report whether a visitor arrived over Tor.
TOR_PORT=8788
ALLOWED_ORIGIN=
# Enables /api/admin/deposit, /api/admin/ledger-check and /api/admin/run-scheduler. Empty = disabled.
ADMIN_KEY=
DB_FILE=./gx.db

# --- Webhooks (payment + deposit confirmations). Empty = webhooks disabled. ---
WEBHOOK_SECRET=
DEPOSIT_CONFIRMATIONS=3
# Sandbox only: make /orders return "pending" so you can test the webhook flow.
PAYMENT_ASYNC=0

# --- Market data ---
# sandbox (random walk, default in sandbox mode) | coingecko (default and required in live mode)
PRICE_FEED=sandbox
# Free tier works for testing. For production use a paid plan:
#   COINGECKO_URL=https://pro-api.coingecko.com   COINGECKO_KEY=your-key
COINGECKO_URL=https://api.coingecko.com
COINGECKO_KEY=
FX_URL=https://open.er-api.com/v6/latest/USD
FEED_INTERVAL_MS=30000
# Orders, swaps, sends and sells are refused (503) if prices are older than this.
STALE_MS=120000

# --- Saved-address safety rule ---
# New saved addresses can't be used, and turning the rule off doesn't take effect, until this many ms pass. 86400000 = 24h.
ADDR_COOLDOWN_MS=0
